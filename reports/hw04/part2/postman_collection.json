{
  "info": {
    "name": "DATA260 HW4 Part 2 - Rental CRUD",
    "description": "Prepared collection for one manually supervised capture; not executed in Postman in this session. Reserve exclusive HTTPS port 8702 and coordinate the evidence database. Local credentials remain blank. Create reserves a UUID intent before POST; returned-ID ownership stays recorded through DELETE for manual 404 proof. Before Update/Delete, confirm ownership with a fresh manual GET. Never clear an uncertain run or retry Create blindly. See MANUAL_CAPTURES.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://127.0.0.1:8702",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "rentalId",
      "value": "",
      "type": "string"
    },
    {
      "key": "createdRental",
      "value": "",
      "type": "string"
    },
    {
      "key": "captureRunId",
      "value": "",
      "type": "string"
    },
    {
      "key": "captureIntent",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "description": "Set local environment variables email/password. Postman cookie jar handles s6102_session. Do not export credentials or capture login bodies/cookie values.",
        "body": {
          "mode": "raw",
          "raw": "{{loginPayload}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const email = pm.variables.get('email');",
              "const password = pm.variables.get('password');",
              "if (!email || !password) { throw new Error('Set local email and password environment variables before login.'); }",
              "pm.variables.set('loginPayload', JSON.stringify({email, password}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const user = pm.response.json().user;",
              "  pm.test('Only public user fields returned', () => pm.expect(Object.keys(user).sort()).to.eql(['email', 'id', 'name']));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Create rental",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/rentals",
        "description": "One manual capture run only. Refuses while captureRunId, captureIntent, rentalId or createdRental is retained. Stores a UUID and immutable email/description intent before POST; records an actual 201 response ID. Keep uncertain runs for manual recovery. Save 01-post-create.png.",
        "body": {
          "mode": "raw",
          "raw": "{{createPayload}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function refuseCapture(message) {",
              "  pm.execution.skipRequest();",
              "  throw new Error(message);",
              "}",
              "const runKeys = ['captureRunId', 'captureIntent', 'rentalId', 'createdRental'];",
              "const retained = runKeys.filter(key => {",
              "  const value = pm.collectionVariables.get(key);",
              "  return value !== undefined && value !== null && String(value).length > 0;",
              "});",
              "if (retained.length > 0) {",
              "  refuseCapture('A prior capture is retained. Confirm its exact ID returns 404, then explicitly clear only captureRunId, captureIntent, rentalId and createdRental before starting another run.');",
              "}",
              "const captureRunId = pm.variables.replaceIn('{{$guid}}');",
              "if (typeof captureRunId !== 'string' || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(captureRunId)) {",
              "  refuseCapture('Postman did not produce a valid capture UUID. No request will be sent.');",
              "}",
              "const payload = {",
              "  listingTitle: 'HW4 Postman capture ' + captureRunId,",
              "  propertyAddress: '260 Capture Lane, San Jose, CA',",
              "  submitterEmail: 'capture+' + captureRunId + '@example.com',",
              "  description: 'HW4 Postman capture run ' + captureRunId,",
              "  propertyType: 'apartment',",
              "  termsAccepted: true",
              "};",
              "pm.collectionVariables.set('captureRunId', captureRunId);",
              "pm.collectionVariables.set('captureIntent', JSON.stringify(payload));",
              "pm.variables.set('createPayload', JSON.stringify(payload));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Create returns 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const row = pm.response.json();",
              "  // Keep all available confirmation data even if an assertion fails; never auto-clear uncertain ownership.",
              "  pm.collectionVariables.set('createdRental', JSON.stringify(row));",
              "  if (row && typeof row === 'object' && row.id !== undefined && row.id !== null) {",
              "    pm.collectionVariables.set('rentalId', String(row.id));",
              "  }",
              "  pm.test('Generated ID is a positive safe integer', () => { pm.expect(Number.isSafeInteger(row.id)).to.be.true; pm.expect(row.id).to.be.above(0); });",
              "  pm.test('Six create fields match persisted intent', () => { const sent = JSON.parse(pm.collectionVariables.get('captureIntent')); Object.keys(sent).forEach(key => pm.expect(row[key]).to.eql(sent[key])); });",
              "}",
              "// A non-201, missing response, or invalid body keeps captureRunId/captureIntent for manual recovery."
            ]
          }
        }
      ]
    },
    {
      "name": "List rentals",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/rentals",
        "description": "Unfiltered record list. Save screenshot 02-get-list.png."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function refuseCapture(message) {",
              "  pm.execution.skipRequest();",
              "  throw new Error(message);",
              "}",
              "const captureRunId = pm.collectionVariables.get('captureRunId');",
              "const idText = pm.collectionVariables.get('rentalId');",
              "if (typeof captureRunId !== 'string' || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(captureRunId)) {",
              "  refuseCapture('Missing valid captureRunId. Do not select or guess a rental ID.');",
              "}",
              "let captureIntent;",
              "let createdRental;",
              "try {",
              "  captureIntent = JSON.parse(pm.collectionVariables.get('captureIntent'));",
              "  createdRental = JSON.parse(pm.collectionVariables.get('createdRental'));",
              "} catch (error) {",
              "  refuseCapture('Missing or invalid capture ownership JSON. Preserve the run variables for manual review.');",
              "}",
              "if (!captureIntent || typeof captureIntent !== 'object' || Array.isArray(captureIntent) ||",
              "    !createdRental || typeof createdRental !== 'object' || Array.isArray(createdRental)) {",
              "  refuseCapture('Capture intent and created rental must be recorded objects.');",
              "}",
              "const expectedDescription = 'HW4 Postman capture run ' + captureRunId;",
              "const expectedEmail = 'capture+' + captureRunId + '@example.com';",
              "if (captureIntent.description !== expectedDescription || captureIntent.submitterEmail !== expectedEmail ||",
              "    createdRental.description !== captureIntent.description || createdRental.submitterEmail !== captureIntent.submitterEmail) {",
              "  refuseCapture('Stored capture UUID markers do not match. Do not mutate this rental.');",
              "}",
              "if (!Number.isSafeInteger(createdRental.id) || createdRental.id <= 0 ||",
              "    String(idText) !== String(createdRental.id)) {",
              "  refuseCapture('rentalId must exactly match the positive integer ID returned by this capture POST.');",
              "}",
              "const validatedId = String(createdRental.id);",
              "if (String(pm.variables.get('rentalId')) !== validatedId) {",
              "  refuseCapture('A resolved rentalId override differs from the recorded capture ID. Remove the override before continuing.');",
              "}",
              "pm.variables.set('rentalId', validatedId);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('List returns 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const rows = pm.response.json(); pm.test('Unfiltered array includes created ID', () => { pm.expect(rows).to.be.an('array'); pm.expect(rows.some(row => row.id === Number(pm.collectionVariables.get('rentalId')))).to.be.true; }); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Read created rental",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/rentals/{{rentalId}}",
        "description": "Read the confirmed returned ID. Before each Update/Delete, manually verify this fresh response has the recorded ID and immutable description/email UUID markers. Initial read is screenshot 03-get-by-id.png. After DELETE, a separate manual GET must prove 404; this request normally expects 200."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function refuseCapture(message) {",
              "  pm.execution.skipRequest();",
              "  throw new Error(message);",
              "}",
              "const captureRunId = pm.collectionVariables.get('captureRunId');",
              "const idText = pm.collectionVariables.get('rentalId');",
              "if (typeof captureRunId !== 'string' || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(captureRunId)) {",
              "  refuseCapture('Missing valid captureRunId. Do not select or guess a rental ID.');",
              "}",
              "let captureIntent;",
              "let createdRental;",
              "try {",
              "  captureIntent = JSON.parse(pm.collectionVariables.get('captureIntent'));",
              "  createdRental = JSON.parse(pm.collectionVariables.get('createdRental'));",
              "} catch (error) {",
              "  refuseCapture('Missing or invalid capture ownership JSON. Preserve the run variables for manual review.');",
              "}",
              "if (!captureIntent || typeof captureIntent !== 'object' || Array.isArray(captureIntent) ||",
              "    !createdRental || typeof createdRental !== 'object' || Array.isArray(createdRental)) {",
              "  refuseCapture('Capture intent and created rental must be recorded objects.');",
              "}",
              "const expectedDescription = 'HW4 Postman capture run ' + captureRunId;",
              "const expectedEmail = 'capture+' + captureRunId + '@example.com';",
              "if (captureIntent.description !== expectedDescription || captureIntent.submitterEmail !== expectedEmail ||",
              "    createdRental.description !== captureIntent.description || createdRental.submitterEmail !== captureIntent.submitterEmail) {",
              "  refuseCapture('Stored capture UUID markers do not match. Do not mutate this rental.');",
              "}",
              "if (!Number.isSafeInteger(createdRental.id) || createdRental.id <= 0 ||",
              "    String(idText) !== String(createdRental.id)) {",
              "  refuseCapture('rentalId must exactly match the positive integer ID returned by this capture POST.');",
              "}",
              "const validatedId = String(createdRental.id);",
              "if (String(pm.variables.get('rentalId')) !== validatedId) {",
              "  refuseCapture('A resolved rentalId override differs from the recorded capture ID. Remove the override before continuing.');",
              "}",
              "pm.variables.set('rentalId', validatedId);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ID read returns 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const row = pm.response.json();",
              "  const original = JSON.parse(pm.collectionVariables.get('createdRental'));",
              "  pm.test('ID read matches recorded capture and immutable fields', () => {",
              "    pm.expect(row.id).to.eql(original.id);",
              "    ['submitterEmail', 'description', 'propertyType', 'termsAccepted'].forEach(key => pm.expect(row[key]).to.eql(original[key]));",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Update created rental",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/rentals/{{rentalId}}",
        "description": "Send only after a fresh manual GET confirms exact ID and immutable UUID markers. Local guards validate saved ownership and reject rentalId overrides; no hidden HTTP requests occur. Sends only title/address. Save 04-put-update.png and database image before Delete.",
        "body": {
          "mode": "raw",
          "raw": "{{updatePayload}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function refuseCapture(message) {",
              "  pm.execution.skipRequest();",
              "  throw new Error(message);",
              "}",
              "const captureRunId = pm.collectionVariables.get('captureRunId');",
              "const idText = pm.collectionVariables.get('rentalId');",
              "if (typeof captureRunId !== 'string' || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(captureRunId)) {",
              "  refuseCapture('Missing valid captureRunId. Do not select or guess a rental ID.');",
              "}",
              "let captureIntent;",
              "let createdRental;",
              "try {",
              "  captureIntent = JSON.parse(pm.collectionVariables.get('captureIntent'));",
              "  createdRental = JSON.parse(pm.collectionVariables.get('createdRental'));",
              "} catch (error) {",
              "  refuseCapture('Missing or invalid capture ownership JSON. Preserve the run variables for manual review.');",
              "}",
              "if (!captureIntent || typeof captureIntent !== 'object' || Array.isArray(captureIntent) ||",
              "    !createdRental || typeof createdRental !== 'object' || Array.isArray(createdRental)) {",
              "  refuseCapture('Capture intent and created rental must be recorded objects.');",
              "}",
              "const expectedDescription = 'HW4 Postman capture run ' + captureRunId;",
              "const expectedEmail = 'capture+' + captureRunId + '@example.com';",
              "if (captureIntent.description !== expectedDescription || captureIntent.submitterEmail !== expectedEmail ||",
              "    createdRental.description !== captureIntent.description || createdRental.submitterEmail !== captureIntent.submitterEmail) {",
              "  refuseCapture('Stored capture UUID markers do not match. Do not mutate this rental.');",
              "}",
              "if (!Number.isSafeInteger(createdRental.id) || createdRental.id <= 0 ||",
              "    String(idText) !== String(createdRental.id)) {",
              "  refuseCapture('rentalId must exactly match the positive integer ID returned by this capture POST.');",
              "}",
              "const validatedId = String(createdRental.id);",
              "if (String(pm.variables.get('rentalId')) !== validatedId) {",
              "  refuseCapture('A resolved rentalId override differs from the recorded capture ID. Remove the override before continuing.');",
              "}",
              "pm.variables.set('rentalId', validatedId);",
              "",
              "// A fresh manual GET must confirm this ID and both immutable UUID markers before Send.",
              "pm.variables.set('updatePayload', JSON.stringify({listingTitle: createdRental.listingTitle + ' updated', propertyAddress: '261 Capture Lane, San Jose, CA'}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Update returns 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const row = pm.response.json(); const original = JSON.parse(pm.collectionVariables.get('createdRental')); const sent = JSON.parse(pm.variables.get('updatePayload'));",
              "  pm.test('ID unchanged and two fields updated', () => { pm.expect(row.id).to.eql(original.id); pm.expect(row.listingTitle).to.eql(sent.listingTitle); pm.expect(row.propertyAddress).to.eql(sent.propertyAddress); });",
              "  pm.test('Other four stored fields preserved', () => ['submitterEmail', 'description', 'propertyType', 'termsAccepted'].forEach(key => pm.expect(row[key]).to.eql(original[key])));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete created rental",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/rentals/{{rentalId}}",
        "description": "Send only after a fresh manual GET confirms exact ID and immutable UUID markers. Deletes that confirmed ID only; no hidden HTTP requests occur. Save 05-delete.png. A 204 retains all run variables: manually GET that exact ID and confirm 404 before explicitly clearing only captureRunId, captureIntent, rentalId and createdRental."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function refuseCapture(message) {",
              "  pm.execution.skipRequest();",
              "  throw new Error(message);",
              "}",
              "const captureRunId = pm.collectionVariables.get('captureRunId');",
              "const idText = pm.collectionVariables.get('rentalId');",
              "if (typeof captureRunId !== 'string' || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(captureRunId)) {",
              "  refuseCapture('Missing valid captureRunId. Do not select or guess a rental ID.');",
              "}",
              "let captureIntent;",
              "let createdRental;",
              "try {",
              "  captureIntent = JSON.parse(pm.collectionVariables.get('captureIntent'));",
              "  createdRental = JSON.parse(pm.collectionVariables.get('createdRental'));",
              "} catch (error) {",
              "  refuseCapture('Missing or invalid capture ownership JSON. Preserve the run variables for manual review.');",
              "}",
              "if (!captureIntent || typeof captureIntent !== 'object' || Array.isArray(captureIntent) ||",
              "    !createdRental || typeof createdRental !== 'object' || Array.isArray(createdRental)) {",
              "  refuseCapture('Capture intent and created rental must be recorded objects.');",
              "}",
              "const expectedDescription = 'HW4 Postman capture run ' + captureRunId;",
              "const expectedEmail = 'capture+' + captureRunId + '@example.com';",
              "if (captureIntent.description !== expectedDescription || captureIntent.submitterEmail !== expectedEmail ||",
              "    createdRental.description !== captureIntent.description || createdRental.submitterEmail !== captureIntent.submitterEmail) {",
              "  refuseCapture('Stored capture UUID markers do not match. Do not mutate this rental.');",
              "}",
              "if (!Number.isSafeInteger(createdRental.id) || createdRental.id <= 0 ||",
              "    String(idText) !== String(createdRental.id)) {",
              "  refuseCapture('rentalId must exactly match the positive integer ID returned by this capture POST.');",
              "}",
              "const validatedId = String(createdRental.id);",
              "if (String(pm.variables.get('rentalId')) !== validatedId) {",
              "  refuseCapture('A resolved rentalId override differs from the recorded capture ID. Remove the override before continuing.');",
              "}",
              "pm.variables.set('rentalId', validatedId);",
              "",
              "// A fresh manual GET must confirm this ID and both immutable UUID markers before Send."
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Delete returns 204', () => pm.response.to.have.status(204));",
              "pm.test('Delete body is empty', () => pm.expect(pm.response.text()).to.equal(''));"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/auth/logout",
        "description": "Revokes this login session and clears its cookie. Do not display reusable cookie values."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Logout returns 204', () => pm.response.to.have.status(204));",
              "pm.test('Logout body is empty', () => pm.expect(pm.response.text()).to.equal(''));"
            ]
          }
        }
      ]
    }
  ]
}
